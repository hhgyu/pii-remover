# syntax=docker/dockerfile:1.8
# pii-remover OPF backend — CUDA image.
#
# Uses the official NVIDIA CUDA runtime base, installs Python + ONNX Runtime
# dependencies, and pre-bakes FP32 ONNX artifacts for both models — the CPU
# image's INT8 weights are a CPU optimisation that costs performance here (see
# the Korean NER stage). Requires the host to expose a GPU via the NVIDIA
# Container Toolkit; the CPU EP remains a safe fallback.
#
# See ADR-0008 for the build strategy and the GPU compose override at
# packages/backend/docker-compose.gpu.yml for usage.
#
# uv replaces pip across every stage. uv is 10-100x faster than pip for
# dependency resolution + download (parallel) and ships as a single static
# binary, mounted in build-time only via --mount=from so it never ends up
# in the published image. BuildKit cache mounts on /root/.cache/uv and
# /root/.cache/huggingface keep pip/HF downloads in build-time cache only.

# Ubuntu 24.04 rather than 22.04 so the base is current; CUDA deliberately stays
# on 12.x, which pins onnxruntime-gpu to <1.27 in requirements-gpu.txt — 1.27
# moved the default PyPI build to CUDA 13, and that wheel loads no CUDA provider
# here. Moving to a CUDA 13 tag means lifting that bound too, and raises the
# host driver floor again.
ARG CUDA_IMAGE=nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04
ARG PYTHON_VERSION=3.14
ARG OPF_MODEL_ID=openai/privacy-filter
ARG KNER_MODEL_ID=soddokayo/koelectra-base-klue-ner

# ---------------------------------------------------------------------------
# Stage 1a — OPF INT8 ONNX downloader (weights are device-agnostic)
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS opf-weights

ARG OPF_MODEL_ID
ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY scripts/requirements-opf-builder.txt .
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install -r requirements-opf-builder.txt

RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    OPF_MODEL_ID="${OPF_MODEL_ID}" python - <<'PY'
from huggingface_hub import hf_hub_download
import os
import shutil

target = "/models/opf-int8"
os.makedirs(target, exist_ok=True)
files = [
    "onnx/model_quantized.onnx",
    "onnx/model_quantized.onnx_data",
    "onnx/model.onnx",
    "onnx/model.onnx_data",
    "onnx/model.onnx_data_1",
    "onnx/model.onnx_data_2",
    "tokenizer.json",
    "tokenizer_config.json",
    "config.json",
    "viterbi_calibration.json",
]
for filename in files:
    try:
        source = hf_hub_download(repo_id=os.environ["OPF_MODEL_ID"], filename=filename)
    except Exception as exc:
        if filename.startswith("onnx/model.onnx_data_"):
            print(f"optional FP32 shard {filename} not present in repo (skipped): {exc}")
            continue
        raise
    shutil.copyfile(source, os.path.join(target, os.path.basename(filename)))
PY

# ---------------------------------------------------------------------------
# Stage 1b — Korean NER ONNX exporter (CPU export; ONNX is device-agnostic)
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS kner-export

ARG KNER_MODEL_ID
ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY scripts/requirements-kner-builder.txt .
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements-kner-builder.txt

# FP32, not INT8 as the CPU image builds. The dynamic-quantised operators have
# no CUDA kernels, so ONNX Runtime partitions the graph and copies tensors back
# and forth on every node it cannot place: measured on this image, KLUE-NER INT8
# runs 15.34ms on CUDA against 6.05ms on the CPU provider, while OPF FP32 runs
# 6.80ms on CUDA against 62.63ms on the CPU. Quantisation is a CPU optimisation;
# shipping it to the GPU image buys a slower model and a larger download.
RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    python -c "\
from optimum.onnxruntime import ORTModelForTokenClassification; \
from transformers import AutoTokenizer; \
mid = '${KNER_MODEL_ID}'; \
tok = AutoTokenizer.from_pretrained(mid); \
m = ORTModelForTokenClassification.from_pretrained(mid, export=True); \
m.save_pretrained('/models/klue-ner-fp32'); \
tok.save_pretrained('/models/klue-ner-fp32')"

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM ${CUDA_IMAGE} AS runtime

ARG OPF_MODEL_ID
ARG KNER_MODEL_ID
ARG PYTHON_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHON_JIT=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/home/app/.cache/huggingface \
    OPF_DEVICE=cuda \
    OPF_HOST=0.0.0.0 \
    OPF_PORT=8000 \
    OPF_MODEL_ID=${OPF_MODEL_ID} \
    OPF_ONNX_PATH=/models/opf-int8 \
    OPF_VARIANT=fp32 \
    KNER_MODEL_ID=${KNER_MODEL_ID} \
    KNER_ONNX_PATH=/models/klue-ner-fp32 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-kor \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home /home/app --create-home app

WORKDIR /app

# Python comes from uv, not apt: Ubuntu 24.04 only ships 3.12 and this image
# tracks the CPU image's 3.14. Two constraints the obvious version gets wrong:
#   - UV_PYTHON_INSTALL_DIR must stay outside /root, which is mode 700, or the
#     `app` user cannot traverse to the interpreter.
#   - Packages go into a venv, not the managed interpreter: uv marks its own
#     Python EXTERNALLY-MANAGED and refuses to install into it.
COPY requirements-gpu.txt requirements.txt
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv python install "${PYTHON_VERSION}" \
    && uv venv --python "${PYTHON_VERSION}" /opt/venv \
    && uv pip install --python /opt/venv/bin/python -r requirements.txt \
    && chmod -R a+rX /opt/python /opt/venv \
    && python -VV

COPY --from=opf-weights --chown=app:app /models/opf-int8 /models/opf-int8
COPY --from=kner-export --chown=app:app /models/klue-ner-fp32 /models/klue-ner-fp32

COPY --chown=app:app server/ ./server/
COPY --chown=app:app pyproject.toml ./pyproject.toml

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fs http://localhost:8000/health || exit 1

CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
