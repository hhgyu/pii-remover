{
  "name": "@pii-remover/proxy",
  "version": "0.0.1",
  "description": "Local LLM proxy — masks PII before Anthropic/OpenAI requests and restores tokens in responses (Phase 3A: non-streaming only).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "pii-remover-proxy": "./bin/pii-remover-proxy.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pii-remover/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
