      "url": "https://github.com/ukkidokiyo/korail2",
      "private": false
    },
    {
      "name": "public github repo, handle looks like a person",
      "url": "https://github.com/hostkimjang/korail-auto-waitlist",
      "private": false
    },
    {
      "name": "github pages site under a personal handle",
      "url": "https://hostkimjang.github.io/docs/index.html",
      "private": false
    },
    {
      "name": "raw githubusercontent file",
      "url": "https://raw.githubusercontent.com/openai/whisper/main/README.md",
      "private": false
    },
    {
