{
  "$schema": "Cross-language URL policy parity fixture.",
  "$invariant": "Python server.detection_policy.is_private_url and TS isPrivateUrl MUST return the same verdict for every case below, under the same options.",
  "$semantics": "private=true means the URL is masked as PII. A URL is private only when it carries a credential, resolves inside a network, or names a tenant workspace — not because its domain is obscure.",
