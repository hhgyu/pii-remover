    {
      "name": "strict still ignores non-http schemes",
      "url": "ftp://files.example.com/pub/readme.txt",
      "private": false
    }
  ],
  "extra_private_suffix_cases": [
    {
      "name": "operator-declared corporate domain",
      "url": "https://admin.acme.com/users/1234",
      "extra_private_suffixes": ["acme.com"],
      "private": true
    },
    {
      "name": "operator-declared domain written as a wildcard",
      "url": "https://git.acme.io/team/repo",
      "extra_private_suffixes": ["*.acme.io"],
      "private": true
    },
    {
      "name": "a sibling domain stays public",
      "url": "https://github.com/acme/repo",
      "extra_private_suffixes": ["acme.com"],
      "private": false
    }
  ]
}
