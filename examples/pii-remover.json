{
  "$schema": "https://pii-remover.dev/schema/v1.json",

  "backend": {
    "type": "single",
    "endpoint": "http://localhost:8000/redact",
    "trust_tier": "local",
    "auth": { "type": "none" },
    "tls": { "verify": true, "pinning": { "enabled": false } },
    "timeout_ms": 5000,
    "retries": 2
  },

  "detection": {
    "enabled_categories": [
      "private_person",
      "private_email",
      "private_phone",
      "private_address",
      "account_number",
      "private_date",
      "private_url",
      "secret",
      "rrn",
      "biz_num",
      "card"
    ]
  },

  "failure_policy": "closed",
  "bypass_env": "PII_REMOVER_BYPASS",

  "logging": {
    "level": "info",
    "redact_logs": true,
    "log_path": null
  }
}
